msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:83
#, php-format
msgid "%1$d self-referential %2$s in the source were skipped (a member cannot connect to themselves)."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:85
#, php-format
msgid "%1$d self-referential %2$s in the source were skipped (a member cannot block themselves)."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:89
#, php-format
msgid "%1$d %2$s in the source had no text and no media, so there was nothing to create."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:96
#, php-format
msgid "%1$d %2$s belonged to a group that did not become a space, so they were dropped rather than published to the global feed."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:101
#, php-format
msgid "%1$d %2$s were hidden from the sitewide feed at the source and had no space to land in, so they were not republished."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:105
#, php-format
msgid "%1$d %2$s pointed at a post that is no longer public, so no card was created."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:109
#, php-format
msgid "%1$d %2$s were on a post that did not migrate, so they were dropped with it."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:121
#, php-format
msgid "%1$d %2$s were refused because their author is not a member of the space they belong to."
msgstr ""

#. translators: 1: number of rows, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:127
#, php-format
msgid "%1$d %2$s were refused because their author can no longer see the post they belong to (for example a pending or former member of a private space)."
msgstr ""

#. translators: 1: number of files, 2: domain label such as "posts".
#: includes/Pipeline/SkipReasons.php:129
#, php-format
msgid "%1$d files attached to imported %2$s were refused by the media library (an audio format it does not accept, for example), so those posts arrived without them."
msgstr ""

