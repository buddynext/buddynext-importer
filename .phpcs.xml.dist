<?xml version="1.0"?>
<ruleset name="BuddyNext Importer">
	<description>WordPress Coding Standards for buddynext-importer (PSR-4, PascalCase filenames, same convention as BuddyNext core).</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!--
	docker/ is the disposable migration fixture: seeders that build a BuddyPress or
	BuddyBoss source, plus measurement scripts. None of it ships in the plugin, and
	all of it runs as top-level code through `wp eval-file`, which cannot satisfy
	the product-code sniffs by construction - a script with no function wrapper has
	only "unprefixed globals", CLI output has nothing to escape, and reading the
	source schema directly is the entire purpose. Gating it would mean ~300 inline
	ignores asserting a standard the file cannot hold.

	It also contains a downloaded WordPress core (.playground/) and built zips
	(.dist/), both gitignored, which buried the plugin's own findings under 28,000
	from code we do not own.

	Everything that ships - includes/, the bootstrap, templates - stays on the full
	WordPress standard with no path exclusions.
	-->
	<exclude-pattern>*/docker/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!-- PSR-4 PascalCase filenames + a hand-written autoloader, like BuddyNext core. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<config name="minimum_supported_wp_version" value="6.6"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="buddynext-importer"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="buddynext_importer"/>
				<element value="BuddyNextImporter"/>
				<element value="BUDDYNEXT_IMPORTER"/>
			</property>
		</properties>
	</rule>
</ruleset>
